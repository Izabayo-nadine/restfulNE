# Copy to backend/.env before docker compose (or merge with your existing .env)
# Docker overrides MONGODB_URI in docker-compose.yml — this file is for reference.

GATEWAY_PORT=5000
FRONTEND_URL=http://localhost:5173
AUTH_SERVICE_PORT=5001
EXTINGUISHER_SERVICE_PORT=5002
INSPECTION_SERVICE_PORT=5003
REPORT_SERVICE_PORT=5004
NOTIFICATION_SERVICE_PORT=5005
AUTH_SERVICE_URL=http://127.0.0.1:5001
EXTINGUISHER_SERVICE_URL=http://127.0.0.1:5002
INSPECTION_SERVICE_URL=http://127.0.0.1:5003
REPORT_SERVICE_URL=http://127.0.0.1:5004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:5005

# Set by docker-compose.yml when using bundled Mongo:
# MONGODB_URI=mongodb://mongo:27017/fems

MONGODB_URI=mongodb://127.0.0.1:27017/fems
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=24h
INTERNAL_SERVICE_KEY=fems-internal-dev-key
NODE_ENV=production

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
